{
  "name": "apex-legends-config",
  "version": "1.0.4",
  "private": true,
  "description": "Apex Legends autoexec.cfg and videoconfig.txt presets",
  "repository": "git@github.com:Gaming-Configs-Overdrive/Apex-Legends.git",
  "author": "pwnyprod <info@it-jh.de>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/variants.mjs --zip",
    "variants": "node scripts/variants.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "format": "prettier --write \"**/*.{js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,yml}\""
  },
  "devDependencies": {
